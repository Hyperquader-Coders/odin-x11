# odin-x11: its place in the binding graph
# Render:  d2 diags/odin-x11.d2 diags/odin-x11.svg

direction: down

title: "odin-x11" {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}

this: "odin-x11\nXlib, Xutil and XKBlib 1.8.7\npackage xlib" {
  style.fill: "#eef6ff"
}
lib: "libX11.so (system:X11)" {
  style.fill: "#fff6e6"
}
consumers: "programs that talk to X\nimport \"x11:xlib\"" {
  style.fill: "#f2f2f2"
}

consumers -> this: collection x11
this -> lib: foreign import
